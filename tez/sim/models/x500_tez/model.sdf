<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="x500_tez">
    <!-- Frame, motors and sensors of the PX4 x500 model (Tools/simulation/gz/models, found via GZ_SIM_RESOURCE_PATH) -->
    <include merge="true">
      <uri>model://x500</uri>
    </include>

    <!-- Camera mount under the bottom plate at the front, between the two slide bars, like the X500 V2 "Depth Camera
         Mount" (docs.px4.io/v1.17/en/frames_multicopter/holybro_x500v2_pixhawk6c). base_link is the centre of the
         body plate; the plate spans about +-0.025 m around it, the landing gear reaches 0.227 m below it.
         Mount dimensions are approximate until measured on the real vehicle. Visual only (no collision). -->
    <link name="camera_mount">
      <pose relative_to="base_link">0.12 0 -0.035 0 0 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia>
          <ixx>0.000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000002</iyy>
          <iyz>0</iyz>
          <izz>0.000002</izz>
        </inertia>
      </inertial>
      <visual name="bracket">
        <geometry>
          <box>
            <size>0.05 0.06 0.02</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_mount</child>
    </joint>

    <!-- Raspberry Pi Camera Module 3, Standard lens, on the front face of the mount, pitched 45 deg down
         (0.785398 rad; positive pitch turns the optical axis +X towards -Z). -->
    <link name="camera_link">
      <pose relative_to="base_link">0.151 0 -0.035 0 0.785398 0</pose>
      <inertial>
        <mass>0.010</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name="camera_board">
        <geometry>
          <box>
            <size>0.012 0.025 0.024</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.4 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="imager" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <topic>/x500_tez/kamera/image</topic>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <camera>
          <camera_info_topic>/x500_tez/kamera/camera_info</camera_info_topic>
          <!-- 66 deg horizontal field of view, Camera Module 3 Standard datasheet. Ideal pinhole (no distortion)
               until the real camera is calibrated in the 2304x1296 mode. -->
          <horizontal_fov>1.151917</horizontal_fov>
          <image>
            <width>2304</width>
            <height>1296</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>500</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.007</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>
  </model>
</sdf>

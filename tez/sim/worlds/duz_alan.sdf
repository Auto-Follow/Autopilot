<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <!-- Flat 500 m x 500 m field. Physics, light and origin as PX4's default world (Tools/simulation/gz/worlds/default.sdf).
       No <plugin> here: the systems come from tez/sim/server.config (GZ_SIM_SERVER_CONFIG_PATH). -->
  <world name="duz_alan">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <!-- Earth field at the <spherical_coordinates> below, from PX4's world magnetic model (src/lib/world_magnetic_model,
         WMM-2020 tables dated 2024.41, what PX4's EKF expects there): declination +3.406 deg, inclination 63.157 deg,
         48 239 nT; ENU [T] = H (sin D, cos D, -tan I), H = F cos I (testler/test_manyetometre.py recomputes it).
         Nothing reads this value: server.config loads no Gazebo magnetometer system (gz-sim 8 would recompute the
         field from its own tables every step anyway, with the east part mirrored for PX4's gz_bridge); the drone's
         magnetometer is PX4's sensor_mag_sim, which uses the same WMM (sim.params SENS_EN_MAGSIM, m06 task group 7 A). -->
    <magnetic_field>1.29398e-06 2.17433e-05 -4.30411e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.6 0.75 0.9 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.30 0.45 0.20 1</ambient>
            <diffuse>0.30 0.45 0.20 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- The drone is part of the world; PX4 (stock airframe 4001) attaches to it by name (PX4_GZ_MODEL_NAME, calistir.sh). -->
    <include>
      <uri>model://x500_tez</uri>
      <name>x500_tez_0</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>
  </world>
</sdf>

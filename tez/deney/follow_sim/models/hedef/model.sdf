<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.9">
  <model name="hedef">
    <!-- Static: moved kinematically by follow_panel.py via /world/<world>/set_pose -->
    <static>true</static>
    <link name="link">
      <visual name="legs">
        <pose>0 0 0.45 0 0 0</pose>
        <geometry><box><size>0.25 0.4 0.9</size></box></geometry>
        <material><ambient>0.55 0.03 0.03 1</ambient><diffuse>0.55 0.03 0.03 1</diffuse></material>
      </visual>
      <visual name="body">
        <pose>0 0 1.2 0 0 0</pose>
        <geometry><box><size>0.3 0.5 0.6</size></box></geometry>
        <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse><emissive>0.25 0 0 1</emissive></material>
      </visual>
      <visual name="head">
        <pose>0 0 1.65 0 0 0</pose>
        <geometry><sphere><radius>0.14</radius></sphere></geometry>
        <material><ambient>0.95 0.8 0.65 1</ambient><diffuse>0.95 0.8 0.65 1</diffuse></material>
      </visual>
      <!-- Nose shows the walking direction (+x) -->
      <visual name="nose">
        <pose>0.2 0 1.2 0 1.5708 0</pose>
        <geometry><cone><radius>0.12</radius><length>0.2</length></cone></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
